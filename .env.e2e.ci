# .env.e2e.ci
# Configuration optimisée pour GitHub Actions (CI/CD)
# Ce fichier doit être commité dans le repository

#############################################
# Backend Sylius
#############################################
# Les containers Docker sur GitHub Actions ne peuvent pas accéder à "localhost"
# Ils doivent utiliser le nom du service Docker (nginx-proxy)
ROUTER_DEFAULT_URI=http://nginx-proxy
TRUSTED_HOSTS=^(localhost|sylius|nginx-proxy|127\.0\.0\.1)$

#############################################
# Frontend Nuxt
#############################################
# GitHub Actions runners sont plus lents (ressources partagées)
# Timeouts augmentés pour éviter les faux positifs
FRONTEND_START_PERIOD=120s
FRONTEND_RETRIES=15
FRONTEND_TIMEOUT=10s

#############################################
# PostgreSQL
#############################################
# Healthcheck plus fréquent pour détecter rapidement la disponibilité
POSTGRES_HEALTHCHECK_INTERVAL=5s
POSTGRES_HEALTHCHECK_TIMEOUT=5s
POSTGRES_HEALTHCHECK_RETRIES=10

#############################################
# Fixtures
#############################################
# Suite minimale pour accélérer les tests sur GitHub Actions
FIXTURES_SUITE=e2e_minimal

#############################################
# Build
#############################################
# Utilise Dockerfile.e2e avec assets pré-buildés pour optimiser CI/CD
DOCKERFILE_BACKEND=Dockerfile.e2e
BUILD_ASSETS_IN_IMAGE=true
