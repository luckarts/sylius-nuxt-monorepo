# API
NUXT_PUBLIC_API_BASE=http://localhost:3000
NUXT_API_SECRET=your-secret-key

# Sylius API (Proxy Backend)
# ===========================
# 🐳 DOCKER : Si Sylius tourne dans un container nommé "sylius" (docker-compose)
SYLIUS_API_URL=http://sylius:8000

# 💻 LOCAL : Si Nuxt tourne directement sur la machine (pas dans Docker)
# SYLIUS_API_URL=http://localhost:8000

# 🐳 DOCKER → HOST : Si Nuxt est dans Docker et Sylius sur la machine hôte
# SYLIUS_API_URL=http://host.docker.internal:8000

# 🌐 PRODUCTION : URL de production
# SYLIUS_API_URL=https://api.votre-domaine.com

SYLIUS_API_TOKEN=your-sylius-api-token

# Database (si nécessaire)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Auth
AUTH_SECRET=your-auth-secret

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
