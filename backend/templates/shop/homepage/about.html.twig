{# Template pour la section À propos de la homepage #}
{# Ce template peut être utilisé comme référence pour créer le bloc CMS 'homepage_about' #}

<section class="about-section">
    <div class="container">
        <h2>{{ 'app.homepage.about.title'|trans }}</h2>

        <div class="features-grid">
            <div class="feature-card">
                <div class="icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                </div>
                <h3>{{ 'app.homepage.about.quality_title'|trans }}</h3>
                <p>{{ 'app.homepage.about.quality_description'|trans }}</p>
            </div>

            <div class="feature-card">
                <div class="icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="1" y="3" width="15" height="13"/>
                        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                        <circle cx="5.5" cy="18.5" r="2.5"/>
                        <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                </div>
                <h3>{{ 'app.homepage.about.delivery_title'|trans }}</h3>
                <p>{{ 'app.homepage.about.delivery_description'|trans }}</p>
            </div>

            <div class="feature-card">
                <div class="icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </div>
                <h3>{{ 'app.homepage.about.support_title'|trans }}</h3>
                <p>{{ 'app.homepage.about.support_description'|trans }}</p>
            </div>
        </div>
    </div>
</section>
