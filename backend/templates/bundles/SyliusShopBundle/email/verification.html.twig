{# Template d'email de vérification personnalisé pour projet E2E #}
{% extends '@SyliusCore/Email/layout.html.twig' %}

{% block subject %}
    {{ 'sylius.email.user.account_verification.subject'|trans({}, null, localeCode)|raw }}
{% endblock %}

{% block content %}
    {# Utiliser ROUTER_DEFAULT_URI pour l'URL de base au lieu du channel hostname #}
    {% set baseUrl = app.request.schemeAndHttpHost %}
    {% set verifyPath = path('sylius_shop_user_verification', { 'token': user.emailVerificationToken, '_locale': localeCode }) %}
    {% set verifyUrl = baseUrl ~ verifyPath %}

    <div style="text-align: center; margin-bottom: 30px;">
        <div style="font-size: 24px;">
            {{ 'sylius.email.user.account_verification.greeting'|trans({}, null, localeCode) }}
            <strong>{{ user.username }}</strong><br>
        </div>
        {{ 'sylius.email.user.account_verification.strategy'|trans({}, null, localeCode) }}:
    </div>

    <div style="text-align: center;">
        <a href="{{ verifyUrl|raw }}"
           style="display: inline-block; text-align: center; background: #1abb9c; padding: 18px 28px; color: #fff; text-decoration: none; border-radius: 3px;">
            {{ 'sylius.email.user.account_verification.statement'|trans({}, null, localeCode) }}
        </a>
    </div>

    {# Debug: Afficher l'URL pour vérifier pendant les tests E2E #}
    <div style="text-align: center; margin-top: 20px; font-size: 11px; color: #999;">
        {{ verifyUrl }}
    </div>
{% endblock %}
